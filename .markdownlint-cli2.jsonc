{
  // markdownlint-cli2 設定（md-lint-format レシピの設定に、MD060 と MD033 の無効化を足したもの）。
  // ここは構造/内容を lint する。Markdown の整形に Prettier は使わない（.prettierignore を参照）。
  "config": {
    "default": true,
    // 行長は Prettier(proseWrap: preserve)と日本語テキストに合わないため無効化
    "MD013": false,
    // 太字ラベルを見出し代わりに使う文書を許容（厳しくするなら true に戻す）
    "MD036": false,
    // 表の列揃えは強制しない（移した文書は business-os の設定の下で、揃えずに書いてある）
    "MD060": false,
    // 本文の <n> などの書き方を許容。<n> は GitHub の表示で消えるため、文書を直してから true に戻す
    "MD033": false,
    // リンクは参照スタイル（[text][label] ＋末尾に [label]: URL）に統一。
    // inline [text](url) は禁止。裸 URL は autolink <url> でよい。
    "MD054": {
      "autolink": true,
      "inline": false,
      "full": true,
      "collapsed": true,
      "shortcut": true,
      "url_inline": false,
    },
  },
  "globs": ["**/*.md"],
  // Respect .gitignore so generated/working files (e.g. tmp/) are not linted.
  // Keeps markdownlint aligned with Prettier, which already honors .gitignore.
  "gitignore": true,
  "ignores": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".claude",
    "CHANGELOG.md",
  ],
}
